## dsn info
##
## logger.* is configured separately (NewLogrusLoggerWithConfig), not in this file.
## Two different "level" knobs:
##   logger.level          → logrus sink (string: debug|info|warn|error|…)
##   databases.*.log_level → xorm SQL filter (string: debug|info|warn|error|off)
##
## Bind request ctx with engine.Context(ctx) so SQL AfterSQL can print trace_id.
## Do not SetLogger per request. Do not Close() the Engine returned by Context().

test:
  # [user[:password]@][net[(addr)]]/dbname[?param1=value1&paramN=valueN]
  dsn: "root:123456@localhost:3306/test?allowNativePasswords=true&parseTime=True"
  show_sql: true       ## default false; SQL is logged at INFO via the injected logger
  max_idle_conns: 10   ## default 5
  max_open_conns: 100  ## default 10
  ## xorm log_level (string): debug|info|warn|error|off — SQL via AfterSQL needs debug or info
  ## Independent of any logger.level (logrus string). Legacy ints 0–4 still accepted.
  log_level: info      ## default debug when omitted
  is_default: true     ## default false
  timeout: 5s          ## mysql connect timeout default 5s
## simple mysql
test2:
  driver:   mysql                 ## default mysql
  database: test2                 ## database name
  host:     localhost             ## default localhost
  port:     3306                  ## default 3306
  user:     root                  ## default root
  password: "123456"              ## default 3306
  charset:  utf8                  ## default utf8
  location: "Asia/Shanghai"       ## default "Local"
  parseTime: true                 ## default "false"
  allowNativePasswords: true      ## default "false"
